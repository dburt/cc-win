<Window x:Class="ClaudeSessions.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeSessions"
        Title="Claude Code — Session History"
        Height="900" Width="1500" MinHeight="480" MinWidth="900"
        Background="{DynamicResource WindowBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:Base64ImageConverter x:Key="Img"/>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <local:NonEmptyToVisibilityConverter x:Key="NonEmpty"/>

        <!-- clickable header used by collapsible rows -->
        <Style x:Key="RowToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" Background="Transparent" CornerRadius="4" Padding="6,3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailKey" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- shared left gutter: timestamp, plus a marker for subagent (sidechain) messages -->
        <DataTemplate x:Key="Gutter">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="↳" Foreground="{DynamicResource ThinkBrush}" FontSize="11"
                           Margin="0,0,4,0" VerticalAlignment="Top"
                           ToolTip="Message from a subagent"
                           Visibility="{Binding IsSidechain, Converter={StaticResource B2V}}"/>
                <TextBlock Text="{Binding TimeText}" ToolTip="{Binding TimeTooltip}"
                           FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource FaintBrush}"/>
            </StackPanel>
        </DataTemplate>

        <ContextMenu x:Key="ItemMenu" x:Shared="False">
            <MenuItem Header="Copy" Command="{x:Static local:TimelineItem.CopyCommand}"
                      CommandParameter="{Binding}"/>
        </ContextMenu>

        <!-- ===================== timeline templates ===================== -->

        <DataTemplate x:Key="UserTemplate">
            <Grid Margin="0,10,0,2" ContextMenu="{StaticResource ItemMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource Gutter}"
                                  HorizontalAlignment="Right" Margin="0,7,10,0"/>
                <Border Grid.Column="1" Background="{DynamicResource UserBubbleBrush}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                        MaxWidth="620" HorizontalAlignment="Left"
                        Padding="20,13,20,15">
                    <StackPanel>
                        <TextBlock Text="You" Foreground="{DynamicResource UserBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <local:MarkdownBlock Foreground="{DynamicResource TextBrush}"
                                             FontFamily="{StaticResource SerifFont}" FontSize="15.5"
                                             Highlight="{Binding DataContext.HighlightTerm,
                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                             Markdown="{Binding Text}"/>
                        <ItemsControl ItemsSource="{Binding Images}" Margin="0,8,0,0"
                                      Visibility="{Binding HasImages, Converter={StaticResource B2V}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Converter={StaticResource Img}}"
                                           MaxHeight="340" HorizontalAlignment="Left" Margin="0,0,0,6"
                                           Stretch="Uniform" StretchDirection="DownOnly"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssistantTemplate">
            <Grid Margin="0,8,0,2" ContextMenu="{StaticResource ItemMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource Gutter}"
                                  HorizontalAlignment="Right" Margin="0,7,10,0"/>
                <!-- MaxWidth is the reading measure: ~80 characters at the serif body size. -->
                <Border Grid.Column="1" BorderBrush="{DynamicResource ClaudeBrush}" BorderThickness="2,0,0,0"
                        MaxWidth="660" HorizontalAlignment="Left"
                        Padding="18,7,18,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Claude" Foreground="{DynamicResource ClaudeBrush}"
                                       FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Model}" Style="{StaticResource Caption}"
                                       Margin="8,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <local:MarkdownBlock Foreground="{DynamicResource TextBrush}"
                                             FontFamily="{StaticResource SerifFont}" FontSize="15.5"
                                             Highlight="{Binding DataContext.HighlightTerm,
                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                             Markdown="{Binding Text}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ThinkingTemplate">
            <Grid Margin="0,1,0,1" ContextMenu="{StaticResource ItemMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource Gutter}"
                                  HorizontalAlignment="Right" Margin="0,6,10,0"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <ToggleButton Style="{StaticResource RowToggle}"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✳" Foreground="{DynamicResource ThinkBrush}" FontSize="11"
                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thinking" Foreground="{DynamicResource ThinkBrush}"
                                       FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Preview}" Style="{StaticResource Caption}"
                                       Margin="9,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="620"/>
                        </StackPanel>
                    </ToggleButton>
                    <Border Visibility="{Binding IsExpanded, Converter={StaticResource B2V}}"
                            Background="{DynamicResource ThinkBgBrush}" CornerRadius="6" Padding="12,9" Margin="6,3,0,6"
                            BorderBrush="{DynamicResource ThinkBorderBrush}" BorderThickness="1">
                        <local:MarkdownBlock Foreground="{DynamicResource ThinkBrush}" FontStyle="Italic"
                                             FontFamily="{StaticResource UiFont}" FontSize="12.5"
                                             Highlight="{Binding DataContext.HighlightTerm,
                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                             Markdown="{Binding Text}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ToolTemplate">
            <Grid Margin="0,1,0,1" ContextMenu="{StaticResource ItemMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource Gutter}"
                                  HorizontalAlignment="Right" Margin="0,6,10,0"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <ToggleButton Style="{StaticResource RowToggle}"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                       Foreground="{DynamicResource ToolBrush}" FontSize="11.5"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="·" Style="{StaticResource Caption}"
                                       Margin="7,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Preview}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding StatusGlyph}" FontSize="11"
                                       Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource LiveBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ToggleButton>

                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource B2V}}"
                                Margin="6,3,0,8">
                        <TextBlock Text="INPUT" Style="{StaticResource Caption}" Margin="0,2,0,3"/>
                        <Border Background="{DynamicResource CodeBackgroundBrush}" CornerRadius="6"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                Padding="11,8">
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="OnInnerScroll">
                                <TextBox Style="{StaticResource CodeView}" Text="{Binding InputJson, Mode=OneWay}"/>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="RESULT" Style="{StaticResource Caption}" Margin="0,9,0,3"
                                   Visibility="{Binding Result, Converter={StaticResource NonEmpty}}"/>
                        <Border Background="{DynamicResource CodeBackgroundBrush}" CornerRadius="6"
                                BorderThickness="1" Padding="11,8"
                                Visibility="{Binding Result, Converter={StaticResource NonEmpty}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="OnInnerScroll">
                                <TextBox Style="{StaticResource CodeView}" Text="{Binding Result, Mode=OneWay}"/>
                            </ScrollViewer>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Images}" Margin="0,8,0,0"
                                      Visibility="{Binding HasImages, Converter={StaticResource B2V}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Converter={StaticResource Img}}"
                                           MaxHeight="420" HorizontalAlignment="Left" Margin="0,0,0,6"
                                           Stretch="Uniform" StretchDirection="DownOnly"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NoticeTemplate">
            <Grid Margin="0,1,0,1" ContextMenu="{StaticResource ItemMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource Gutter}"
                                  HorizontalAlignment="Right" Margin="0,4,10,0"/>
                <Border Grid.Column="1" Margin="12,2,0,2" Padding="10,6" CornerRadius="5"
                        Background="{DynamicResource CardBrush}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource ErrorBgBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <TextBox Style="{StaticResource CodeView}" Text="{Binding Text, Mode=OneWay}"
                                 MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                 Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DayTemplate">
            <Grid Margin="14,18,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Text}" Style="{StaticResource Caption}"
                           FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Height="1" Background="{DynamicResource BorderBrush2}"
                        VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <local:TimelineTemplateSelector x:Key="Selector"
                                        Day="{StaticResource DayTemplate}"
                                        User="{StaticResource UserTemplate}"
                                        Assistant="{StaticResource AssistantTemplate}"
                                        Thinking="{StaticResource ThinkingTemplate}"
                                        Tool="{StaticResource ToolTemplate}"
                                        Notice="{StaticResource NoticeTemplate}"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== top bar ===================== -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="9" Height="9" CornerRadius="4.5" Background="{DynamicResource ClaudeBrush}"
                            Margin="0,0,9,0"/>
                    <TextBlock Text="Claude Code" FontWeight="SemiBold" FontSize="13.5"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Session History" Style="{StaticResource Label}" FontSize="13.5"
                               Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBox x:Name="TranscriptSearch" Style="{StaticResource SearchBox}" Width="240"
                             Tag="Search this transcript…  (Ctrl+F)"
                             Text="{Binding TranscriptFilter, UpdateSourceTrigger=PropertyChanged, Delay=180}"/>
                    <ToggleButton Style="{StaticResource PillToggle}" Content="Thinking" Margin="10,0,0,0"
                                  IsChecked="{Binding ShowThinking}"/>
                    <ToggleButton Style="{StaticResource PillToggle}" Content="Tools" Margin="6,0,0,0"
                                  IsChecked="{Binding ShowTools}"/>
                    <ToggleButton Style="{StaticResource PillToggle}" Content="System" Margin="6,0,0,0"
                                  IsChecked="{Binding ShowNotices}"
                                  ToolTip="Injected context, hook output and API errors"/>
                    <ToggleButton Style="{StaticResource PillToggle}" Margin="14,0,0,0"
                                  IsChecked="{Binding Follow}"
                                  ToolTip="Stay pinned to the newest message as it streams in">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,6,0"
                                    Background="{DynamicResource LiveBrush}" VerticalAlignment="Center"
                                    Visibility="{Binding Follow, Converter={StaticResource B2V}}"/>
                            <TextBlock Text="Follow" FontSize="11.5" Foreground="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding ThemeLabel}" Style="{StaticResource GhostButton}"
                            MinWidth="52" Margin="0,0,10,0" Command="{Binding CycleThemeCommand}"
                            ToolTip="Appearance — click to cycle Auto / Light / Dark"/>
                    <Button Content="Expand all" Style="{StaticResource GhostButton}"
                            Command="{Binding ExpandAllToolsCommand}"/>
                    <Button Content="Collapse all" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                            Command="{Binding CollapseAllToolsCommand}"/>
                    <Button Content="Refresh" Margin="10,0,0,0" Command="{Binding RefreshCommand}"
                            ToolTip="Rescan for sessions (F5)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== body ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="316" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- sessions -->
            <Grid Grid.Column="0" Background="{DynamicResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="90"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="SessionSearch" Grid.Row="0" Style="{StaticResource SearchBox}"
                         Margin="10,10,10,8" Tag="Search sessions and messages…  (Ctrl+K)"
                         Text="{Binding SessionFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}"/>

                <TreeView x:Name="SessionTree" Grid.Row="1" ItemsSource="{Binding Projects}"
                          Margin="4,0,2,6" SelectedItemChanged="OnSessionSelected"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:ProjectVM}"
                                                  ItemsSource="{Binding Sessions}">
                            <Grid Margin="0,4,6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,6,0"
                                                Background="{DynamicResource LiveBrush}" VerticalAlignment="Center"
                                                Visibility="{Binding HasLive, Converter={StaticResource B2V}}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DisplayPath}" Style="{StaticResource Caption}"
                                               ToolTip="{Binding Dir}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="8"
                                        Padding="6,1" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}"/>
                                </Border>
                            </Grid>
                        </HierarchicalDataTemplate>

                        <DataTemplate DataType="{x:Type local:SessionVM}">
                            <StackPanel Margin="0,4,6,5">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,6,0"
                                            Background="{DynamicResource LiveBrush}" VerticalAlignment="Center"
                                            Visibility="{Binding IsLive, Converter={StaticResource B2V}}"
                                            ToolTip="Active in the last two minutes"/>
                                    <TextBlock Text="{Binding Title}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" MaxWidth="250"
                                               ToolTip="{Binding Title}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="12,1,0,0">
                                    <TextBlock Text="{Binding Ago}" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="·" Style="{StaticResource Caption}" Margin="5,0"/>
                                    <TextBlock Text="{Binding TurnsText}" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="·" Style="{StaticResource Caption}" Margin="5,0"/>
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>

                <!-- full-text results across every session -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0"
                        Background="{DynamicResource WindowBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasSearchResults}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="12,8,10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Text" Value="{Binding SearchSummary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                                <Setter Property="Text" Value="Searching all transcripts…"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="1" Content="Clear" Style="{StaticResource GhostButton}"
                                    Padding="6,2" FontSize="10.5" Command="{Binding ClearSearchCommand}"/>
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}" MaxHeight="440"
                                 Background="Transparent" BorderThickness="0" Margin="0,0,0,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 MouseDoubleClick="OnResultActivated"
                                 KeyDown="OnResultKey">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="B" Background="Transparent" Padding="12,6,10,7">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="B" Property="Background"
                                                                Value="{DynamicResource HoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="B" Property="Background"
                                                                Value="{DynamicResource SelectedBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel ToolTip="{Binding SessionTitle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource CardBrush}" CornerRadius="3"
                                                    Padding="4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Caption}"
                                                           FontSize="9.5"/>
                                            </Border>
                                            <TextBlock Text="{Binding SessionTitle}" Style="{StaticResource Caption}"
                                                       Margin="6,0,0,0" MaxWidth="180"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}"
                                                       Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" MaxHeight="34" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="11.5" Foreground="{DynamicResource TextBrush}">
                                            <Run Text="{Binding Before, Mode=OneWay}"
                                                 Foreground="{DynamicResource MutedBrush}"/><Run
                                                 Text="{Binding Match, Mode=OneWay}"
                                                 Background="{DynamicResource MatchBrush}"
                                                 FontWeight="SemiBold"/><Run
                                                 Text="{Binding After, Mode=OneWay}"
                                                 Foreground="{DynamicResource MutedBrush}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1"/>

            <!-- transcript -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="22,12,22,11" Background="{DynamicResource WindowBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1"
                        Visibility="{Binding HasSelection, Converter={StaticResource B2V}}"
                        DataContext="{Binding SelectedDetail}">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Cwd}" Style="{StaticResource Caption}"
                                       FontFamily="{StaticResource MonoFont}"/>
                            <TextBlock Text="·" Style="{StaticResource Caption}" Margin="6,0"/>
                            <TextBlock Text="{Binding Location}" Style="{StaticResource Caption}"/>
                            <TextBlock Text="·" Style="{StaticResource Caption}" Margin="6,0"/>
                            <TextBlock Text="{Binding Model}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ListBox x:Name="TranscriptList" Grid.Row="1"
                         ItemsSource="{Binding TimelineView}"
                         ItemTemplateSelector="{StaticResource Selector}"
                         ItemContainerStyle="{StaticResource TranscriptItem}"
                         Background="Transparent" BorderThickness="0"
                         Padding="14,8,16,26"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.ScrollChanged="OnTranscriptScroll"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         HorizontalContentAlignment="Stretch"/>

                <TextBlock Grid.Row="1" Text="Select a session on the left"
                           Foreground="{DynamicResource FaintBrush}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <GridSplitter Grid.Column="3" Width="1"/>

            <!-- details -->
            <Border Grid.Column="4" Background="{DynamicResource PanelBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelection, Converter={StaticResource B2V}}">
                    <StackPanel Margin="18,16,16,20" DataContext="{Binding SelectedDetail}">
                        <TextBlock Text="SESSION" Style="{StaticResource Caption}" Margin="0,0,0,10"/>

                        <TextBlock Text="Working directory" Style="{StaticResource DetailKey}"/>
                        <TextBlock Text="{Binding Cwd}" Style="{StaticResource DetailValue}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>

                        <TextBlock Text="Git branch" Style="{StaticResource DetailKey}"/>
                        <TextBlock Text="{Binding Branch}" Style="{StaticResource DetailValue}"/>

                        <TextBlock Text="Model" Style="{StaticResource DetailKey}"/>
                        <TextBlock Text="{Binding Model}" Style="{StaticResource DetailValue}"/>

                        <TextBlock Text="Started" Style="{StaticResource DetailKey}"/>
                        <TextBlock Text="{Binding Started}" Style="{StaticResource DetailValue}"/>

                        <TextBlock Text="Last activity" Style="{StaticResource DetailKey}"/>
                        <TextBlock Text="{Binding Ended}" Style="{StaticResource DetailValue}"/>

                        <TextBlock Text="Elapsed" Style="{StaticResource DetailKey}"/>
                        <TextBlock Text="{Binding Elapsed}" Style="{StaticResource DetailValue}"/>

                        <TextBlock Text="Messages" Style="{StaticResource DetailKey}"/>
                        <TextBlock Text="{Binding Turns}" Style="{StaticResource DetailValue}"/>

                        <TextBlock Text="Tool calls" Style="{StaticResource DetailKey}"/>
                        <TextBlock Text="{Binding ToolCalls}" Style="{StaticResource DetailValue}"/>

                        <TextBlock Text="Tools used" Style="{StaticResource DetailKey}"/>
                        <TextBlock Text="{Binding Tools}" Style="{StaticResource DetailValue}" FontSize="11.5"/>

                        <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,2,0,14"/>
                        <TextBlock Text="TOKENS" Style="{StaticResource Caption}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Input" Style="{StaticResource DetailKey}"/>
                                <TextBlock Text="{Binding InputTokens}" FontSize="15" Margin="0,0,0,12"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="Output" Style="{StaticResource DetailKey}"/>
                                <TextBlock Text="{Binding OutputTokens}" FontSize="15" Margin="0,0,0,12"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Cache write" Style="{StaticResource DetailKey}"/>
                                <TextBlock Text="{Binding CacheWrite}" FontSize="15" Margin="0,0,0,12"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="Cache read" Style="{StaticResource DetailKey}"/>
                                <TextBlock Text="{Binding CacheRead}" FontSize="15" Margin="0,0,0,12"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Total" Style="{StaticResource DetailKey}"/>
                                <TextBlock Text="{Binding TotalTokens}" FontSize="15"
                                           Foreground="{DynamicResource ClaudeBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="Est. cost (AUD)" Style="{StaticResource DetailKey}"/>
                                <TextBlock Text="{Binding Cost}" FontSize="15"
                                           Foreground="{DynamicResource ClaudeBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,2,0,14"/>
                        <TextBlock Text="FILE" Style="{StaticResource Caption}" Margin="0,0,0,10"/>

                        <TextBlock Text="Session id" Style="{StaticResource DetailKey}"/>
                        <TextBlock Text="{Binding SessionId}" Style="{StaticResource DetailValue}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"/>

                        <TextBlock Text="Records / size" Style="{StaticResource DetailKey}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{Binding Records}" FontSize="12.5"/>
                            <TextBlock Text=" · " Foreground="{DynamicResource MutedBrush}" FontSize="12.5"/>
                            <TextBlock Text="{Binding Size}" FontSize="12.5"/>
                        </StackPanel>

                        <TextBlock Text="Claude Code version" Style="{StaticResource DetailKey}"/>
                        <TextBlock Text="{Binding Version}" Style="{StaticResource DetailValue}"/>

                        <TextBlock Text="Path" Style="{StaticResource DetailKey}"/>
                        <TextBlock Text="{Binding Path}" Style="{StaticResource DetailValue}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===================== status bar ===================== -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Status}" Style="{StaticResource Label}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding VisibleCountText}" Style="{StaticResource Label}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Reveal in Explorer" Style="{StaticResource GhostButton}"
                            Command="{Binding RevealCommand}"/>
                    <Button Content="Copy path" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                            Command="{Binding CopyPathCommand}"/>
                    <Button Content="Export .md" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                            Command="{Binding ExportCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
